{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "workers/*": ["workers/src/*"],
      "frontend/*": ["frontend/src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["workers/**/*", "frontend/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "qmd-main", ".wrangler", "frontend/dist"]
}
